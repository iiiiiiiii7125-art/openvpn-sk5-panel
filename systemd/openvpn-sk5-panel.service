[Unit]
Description=OpenVPN + SK5 egress panel (openvpn-sk5-panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openvpn-sk5-panel/panel
EnvironmentFile=/etc/openvpn-sk5-panel/panel.env
# NOTE: panel/app.py serves plain HTTP on 8443. The launcher below is
# generated by install.sh (it imports the same Flask app and serves it
# with ssl_context from /etc/openvpn-sk5-panel/panel-cert.pem, so the
# published address https://<IP>:8443 is real). No file under panel/
# is modified. If the wrapper is absent (manual install), fall back to:
#   ExecStart=/usr/bin/python3 /opt/openvpn-sk5-panel/panel/app.py
# (plain http://<IP>:8443 in that case).
ExecStart=/usr/bin/python3 /opt/openvpn-sk5-panel/run-panel-tls.py
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
